# ─── PayPal Sandbox ───
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ─── AI / LLM ───
# Per-role model config (buyer, seller, attacker, verifier)
LLM_BUYER_BASE_URL=https://api.openai.com/v1
LLM_BUYER_API_KEY=sk-...
LLM_BUYER_MODEL=gpt-4o-mini

LLM_SELLER_BASE_URL=https://api.openai.com/v1
LLM_SELLER_API_KEY=sk-...
LLM_SELLER_MODEL=gpt-4o-mini

LLM_ATTACKER_BASE_URL=https://api.openai.com/v1
LLM_ATTACKER_API_KEY=sk-...
LLM_ATTACKER_MODEL=gpt-4o

LLM_VERIFIER_BASE_URL=https://api.openai.com/v1
LLM_VERIFIER_API_KEY=sk-...
LLM_VERIFIER_MODEL=gpt-4o

# ─── Database ───
DATABASE_URL=sqlite:///./mandate_arena.db

# ─── App ───
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-string

# ─── Arena abuse controls ───
ARENA_RATE_LIMIT_PER_IP=60
ARENA_SESSION_TTL_SECONDS=1800
ARENA_MAX_INPUT_LENGTH=2000
ARENA_MODEL_SPEND_LIMIT_USD=50.00
ARENA_KILL_SWITCH=false
